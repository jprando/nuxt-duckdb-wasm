{
  "typescript": {
    "semiColons": "asi",
    "quoteStyle": "alwaysSingle",
    "trailingCommas": "never",
    "typeLiteral.separatorKind.singleLine": "comma"
  },
  "json": {
  },
  "markdown": {
  },
  "toml": {
  },
  "dockerfile": {
  },
  "malva": {
  },
  "markup": {
    "maxAttrsPerLine": 1
  },
  "yaml": {
  },
  "excludes": [
    "**/node_modules",
    "**/*-lock.json",
    "**/.output",
    "**/.nuxt"
  ],
  "plugins": [
    "./tools/dprint-plugins/typescript-0.95.15.wasm",
    "./tools/dprint-plugins/json-0.21.1.wasm",
    "./tools/dprint-plugins/markdown-0.20.0.wasm",
    "./tools/dprint-plugins/toml-0.7.0.wasm",
    "./tools/dprint-plugins/dockerfile-0.3.3.wasm",
    "./tools/dprint-plugins/malva-v0.15.2.wasm",
    "./tools/dprint-plugins/markup_fmt-v0.25.3.wasm",
    "./tools/dprint-plugins/pretty_yaml-v0.6.0.wasm"
  ]
}
